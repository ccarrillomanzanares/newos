# =============================================================================
# AgentOS — fragmento de configuración del kernel Linux (x86-64)
#
# Se aplica SOBRE el defconfig x86_64 del propio kernel:
#   BR2_LINUX_KERNEL_USE_DEFCONFIG="x86_64"
#   BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES=".../kernel_config"
# igual que hacen las distribuciones: el defconfig del kernel es la fuente única
# de verdad para el HARDWARE, y este fichero solo contiene las diferencias
# DELIBERADAS de AgentOS (política y entorno de pruebas, no catálogo de drivers).
#
# REGLA DE ORO: aquí NO se enumeran drivers.
# Los drivers (GPU, red, audio, USB, almacenamiento, teclado, touchpad...) los
# aporta el defconfig del kernel, compilados como módulos, y se cargan solos por
# modalias vía udev — como en cualquier distribución. Así el sistema arranca en
# hardware que no conocemos de antemano.
#
# Antes (hasta c980a136) este fichero enumeraba a mano el hardware soportado
# (i915, iwlwifi, rtw88, snd-hda, r8169...), lo que dejaba el kernel rígido: lo
# que no estaba en esa lista, simplemente no existía. Motivo del cambio y
# evidencia medida: ver docs/ADR-001-kernel-generico.md.
#
# Al tocar este fichero: preferir AÑADIR política, no hardware. Si surge un
# dispositivo concreto que falla, comprobar ANTES si el defconfig ya lo trae.
# =============================================================================

# --- Identidad ---------------------------------------------------------------
CONFIG_LOCALVERSION="-agentos"
CONFIG_DEFAULT_HOSTNAME="agentos"

# --- Compresión y arranque silencioso (requisito de producto) ----------------
CONFIG_KERNEL_ZSTD=y
# CONFIG_LOGO is not set
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
# CONFIG_LOGO_LINUX_CLUT224 is not set

# --- Latencia para voz (buena respuesta de audio sin coste de PREEMPT_RT) ----
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y

# --- Aislamiento de recursos (llama-server / AgentD / bash_exec) -------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

# --- Rendimiento de inferencia con poca RAM (objetivo: 8 GB) ----------------
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ZSWAP=y

# --- Que el agente pueda inspeccionar su propio kernel ----------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- IPC del agente y firewall gestionado por el agente ---------------------
# CONFIG_UNIX es la base del socket de AgentD; NETFILTER/NF_TABLES es lo que el
# agente manipula para administrar la red (pilar 2: autoadministración).
CONFIG_UNIX=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y

# --- Inferencia con memoria no uniforme (LLM) -------------------------------
CONFIG_NUMA=y

# --- Raíz A/B futura (fase 5) -----------------------------------------------
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# --- Cifrado (fase 5: LUKS2) ------------------------------------------------
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y

# --- Seguridad --------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Requisitos del MEDIO DE ARRANQUE propio ---------------------------------
# No es catálogo de hardware: AgentOS arranca de CD (ISO) y de USB con GRUB, en
# BIOS y en UEFI, y debe poder leer su propia raíz. Si esto desaparece, el medio
# de instalación deja de arrancar.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_FB_EFI=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MODULES=y
CONFIG_FW_LOADER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Entornos donde se PRUEBA AgentOS ---------------------------------------
# No es hardware de usuario: son las máquinas virtuales donde se verifica el
# sistema antes de tocar un portátil real. Si faltan, no hay forma de probarlo.
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- Poda deliberada por tamaño ---------------------------------------------
# Solo se deja fuera lo que engorda la imagen sin aportar al producto.
# NO desactivar aquí nada que el defconfig traiga por hardware (p. ej. BT o
# STAGING): eso volvería a hacer el kernel rígido. Eso se deja al defconfig.
# CONFIG_DEBUG_INFO is not set
# CONFIG_FTRACE is not set

# --- Neutralizar lo que es de Ubuntu, no del kernel (rompe el build) ---------
# Estas cuatro vienen heredadas de la config de Ubuntu y NO valen en nuestro
# árbol. Verificado: sin esto, el build falla o el kernel engorda sin motivo.
#   SYSTEM_TRUSTED_KEYS apunta a "debian/canonical-certs.pem", que no existe
#   aquí -> el build aborta.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
#   MODULE_SIG es la firma de módulos de Ubuntu: no la necesitamos y complica
#   el arranque.
CONFIG_MODULE_SIG=n
#   DEBUG_INFO = kernel enorme (cientos de MB) y compilación eterna.
CONFIG_DEBUG_INFO=n

