# =============================================================================
# AgentOS — Buildroot defconfig (x86_64, portátil real: ISO + imagen USB, BIOS y UEFI)
# Uso:  make build   (ver Makefile; equivale a make BR2_EXTERNAL=... defconfig + make)
# Referencia: Buildroot 2024.02.6 LTS.
# Salidas (build/output/images):
#   agentos.img  -> grabar en USB con dd (BIOS + UEFI, sistema "live" persistente)
#   agentos.iso  -> DVD / VM (BIOS + UEFI, El Torito; el sistema corre en RAM)
# Para instalar en el disco interno, desde el sistema live: agentos-install
# =============================================================================

# --- Arquitectura -----------------------------------------------------------
BR2_x86_64=y
BR2_x86_corei7=y
# BR2_X86_CPU_HAS_SSE4_2 lo activa automáticamente BR2_x86_corei7 (Nehalem+)

# --- Toolchain --------------------------------------------------------------
# glibc: necesaria para las wheels manylinux de pip (faster-whisper, ctranslate2)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# --- Sistema ----------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="agentos"
BR2_TARGET_GENERIC_ISSUE="AgentOS v0.1 - sistema operativo conversacional"
# root con contraseña "agent" (desarrollo). Cambiar con 'passwd' tras instalar.
BR2_TARGET_GENERIC_ROOT_PASSWD="agent"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="tty2"
BR2_TARGET_GENERIC_GETTY_AUTOLOGIN=y
BR2_TARGET_GENERIC_GETTY_AUTOLOGIN_USER="agent"
BR2_SYSTEM_BIN_SH_BASH=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US es_ES"
BR2_GENERATE_LOCALE="es_ES.UTF-8 en_US.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Madrid"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_AGENTOS_PATH)/board/agentos/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AGENTOS_PATH)/build/overlays"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AGENTOS_PATH)/board/agentos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AGENTOS_PATH)/board/agentos/post-image.sh"

# --- Kernel (LTS 6.6.x más reciente de Buildroot 2024.02) -------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AGENTOS_PATH)/build/configs/kernel_config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# --- Firmware para hardware de portátil habitual ----------------------------
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y

# --- Paquetes base ----------------------------------------------------------
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_GIT=y

# --- Red: NetworkManager + WiFi ----------------------------------------------
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y

# --- Python (AgentD) --------------------------------------------------------
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON_PSUTIL=y
BR2_PACKAGE_PYTHON_COLORAMA=y
BR2_PACKAGE_PYTHON_AIOFILES=y
BR2_PACKAGE_PYTHON_HTTPX=y
BR2_PACKAGE_PYTHON_WEBSOCKETS=y
BR2_PACKAGE_PYTHON_NUMPY=y
# faster-whisper y sounddevice se instalan con pip en el primer arranque
# con red (/etc/init.d/S60agentos-pip); sounddevice usa portaudio:
BR2_PACKAGE_PORTAUDIO=y

# --- Audio ------------------------------------------------------------------
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_PULSEAUDIO=y
BR2_PACKAGE_PULSEAUDIO_DAEMON=y

# --- GUI: Weston (Wayland) + navegador WPE (cog) ------------------------------
# Buildroot 2024.02 no incluye Chromium; se usa cog/WPE WebKit como navegador.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_SHELL_KIOSK=y
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_PLATFORM_FDO=y
BR2_PACKAGE_DEJAVU=y

# --- Bootloader: GRUB2 BIOS (i386-pc) + UEFI (x86_64-efi) ---------------------
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,msdos1"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat iso9660 part_msdos part_gpt normal biosdisk search search_fs_file test"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_AGENTOS_PATH)/board/agentos/grub-embed.cfg"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat iso9660 part_msdos part_gpt normal efi_gop search search_fs_file test"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_AGENTOS_PATH)/board/agentos/grub-embed.cfg"
# grub-install + módulos en el sistema: los usa agentos-install
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# --- Sistemas de ficheros / imágenes ------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="agentos-root"
BR2_TARGET_ROOTFS_EXT2_SIZE="2048M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_AGENTOS_PATH)/board/agentos/grub-iso.cfg"
BR2_TARGET_ROOTFS_ISO9660_INITRD=y

# --- Herramientas de host para post-image ------------------------------------
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
