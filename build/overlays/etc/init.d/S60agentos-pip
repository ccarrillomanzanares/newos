#!/bin/sh
# /etc/init.d/S60agentos-pip — DESACTIVADO.
#
# Antes instalaba faster-whisper y sounddevice en el primer arranque (el metodo
# viejo de voz). La voz ahora la da Gemini Live, que es speech-to-speech nativo
# y solo necesita 'websockets' (ya viene en la imagen). Instalar aquellos
# paquetes era lento, confundia al agente (veia dependencias de voz sueltas) y
# ademas fallaba por PortAudio. Se deja el script como no-op para no romper
# nada que lo llame.
start() { :; }
case "$1" in
    start|stop|restart|reload) start ;;
    *) echo "Uso: $0 {start|stop}"; exit 1 ;;
esac
exit 0
