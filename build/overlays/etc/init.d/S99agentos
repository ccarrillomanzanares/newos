#!/bin/sh
# /etc/init.d/S99agentos — arranca la interfaz y AgentD al final del boot.
# Uso: /etc/init.d/S99agentos {start|stop|restart|status}
#
# ORDEN IMPORTANTE: la interfaz ES el SO, asi que se arranca PRIMERO y sin
# esperar a nada. AgentD necesita RED (su backend LLM es remoto) y esa espera
# no debe retrasar la pantalla: si tarda, el usuario ve una pantalla vacia sin
# saber por que. La red y el agente se buscan en SEGUNDO PLANO.
#
# NOTA: BusyBox start-stop-daemon NO soporta -d (chdir).
#       El cd se hace dentro del propio comando shell.

NAME=agentd
AGENTOS_HOME=/opt/agentos
PIDFILE=/run/agentos/agentd.pid
LOGFILE=/var/log/agentd.log
PYTHON=/usr/bin/python3
GUI_PIDFILE=/run/agentos/gui.pid
GUI_LOGFILE=/var/log/agentos-gui.log
INITLOG=/var/log/agentd-init.log

export AGENTOS_MODE=os
export AGENTOS_DATA_DIR=/data/agent
export AGENTOS_SOCKET=/run/agentos/input.sock
export AGENTOS_MODEL_PATH=/data/models/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
export AGENTOS_LOG_FORMAT=json
export PYTHONPATH="$AGENTOS_HOME"
# El agente abre aplicaciones graficas con bash_exec: necesita saber DONDE esta
# el display, y lo hereda todo lo que ejecute.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export HOME=/root

load_config() {
    [ -f /etc/default/agentos ] && { set -a; . /etc/default/agentos; set +a; }
}

# Esperar a que haya RED DE VERDAD (NetworkManager arranca en S45, pero reunir
# IP y DNS tarda mas). Se ejecuta EN SEGUNDO PLANO.
AGENTOS_NET_WAIT="${AGENTOS_NET_WAIT:-45}"
wait_for_network() {
    i=0
    while [ "$i" -lt "$AGENTOS_NET_WAIT" ]; do
        if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && ping -c1 -W2 ollama.com >/dev/null 2>&1; then
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}

# Lanza AgentD y espera su socket (max 60 s). Devuelve 0 si esta listo.
launch_agentd() {
    start-stop-daemon -S -q -b -m -p "$PIDFILE" \
        -x /bin/sh -- -c "cd $AGENTOS_HOME && exec $PYTHON -m core.ipc.socket_server >> $LOGFILE 2>&1"
    i=0
    while [ ! -S "$AGENTOS_SOCKET" ] && [ $i -lt 60 ]; do
        sleep 1; i=$((i + 1))
    done
    [ -S "$AGENTOS_SOCKET" ]
}

# Interfaz grafica: es la pantalla del SO. La ejecuta agentos-gui, un supervisor
# que la relanza sola si el navegador o el servidor terminan.
start_gui() {
    printf "Iniciando interfaz grafica: "
    start-stop-daemon -S -q -b -m -p "$GUI_PIDFILE" \
        -x /bin/sh -- -c "exec /usr/bin/agentos-gui"
    echo "OK"
}

# AgentD EN SEGUNDO PLANO: espera red y reintenta sin bloquear el arranque.
start_agent_bg() {
    (
        if wait_for_network; then printf "[red lista] "; else printf "[aviso: sin red] "; fi
        intento=1
        while [ "$intento" -le 3 ]; do
            if launch_agentd; then echo "[agentd OK]"; exit 0; fi
            if [ "$intento" -lt 3 ]; then printf "[reintento %s] " "$intento"; sleep 5; fi
            intento=$((intento + 1))
        done
        echo "[agentd no responde; ver $LOGFILE]"
    ) >> "$INITLOG" 2>&1 &
}

start() {
    load_config
    mkdir -p /run/agentos /data/agent /data/models
    chmod 0750 /run/agentos
    printf "Iniciando %s: " "$NAME"

    # 1) La interfaz, YA (no depende de la red).
    start_gui
    # 2) La red y AgentD, en segundo plano.
    start_agent_bg
    echo "OK"
}

stop_gui() {
    [ -f "$GUI_PIDFILE" ] && start-stop-daemon -K -q -p "$GUI_PIDFILE" -s TERM
    rm -f "$GUI_PIDFILE"
}

stop() {
    stop_gui
    printf "Deteniendo %s: " "$NAME"
    start-stop-daemon -K -q -p "$PIDFILE" -s TERM
    i=0
    while [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && [ $i -lt 15 ]; do
        sleep 1; i=$((i + 1))
    done
    rm -f "$PIDFILE"
    echo "OK"
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME en ejecucion (PID $(cat "$PIDFILE"))"
    else
        echo "$NAME detenido"; return 3
    fi
}

case "$1" in
    start)          start   ;;
    stop)           stop    ;;
    restart|reload) stop; start ;;
    status)         status  ;;
    *)  echo "Uso: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit $?
