#!/bin/sh
# /etc/init.d/S99agentos — arranca AgentD al final del boot (BusyBox init).
# Uso: /etc/init.d/S99agentos {start|stop|restart|status}
#
# NOTA: BusyBox start-stop-daemon NO soporta -d (chdir).
#       El cd se hace dentro del propio comando shell.

NAME=agentd
AGENTOS_HOME=/opt/agentos
PIDFILE=/run/agentos/agentd.pid
LOGFILE=/var/log/agentd.log
PYTHON=/usr/bin/python3
GUI_PIDFILE=/run/agentos/gui.pid
GUI_LOGFILE=/var/log/agentos-gui.log

export AGENTOS_MODE=os
export AGENTOS_DATA_DIR=/data/agent
export AGENTOS_SOCKET=/run/agentos/input.sock
export AGENTOS_MODEL_PATH=/data/models/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
export AGENTOS_LOG_FORMAT=json
export PYTHONPATH="$AGENTOS_HOME"
# El agente abre aplicaciones gráficas con bash_exec: necesita saber DÓNDE está
# el display. Se exporta aquí, en el entorno del servicio, para que lo hereden
# AgentD y todo lo que ejecute. Antes solo se definía dentro de start_gui(), es
# decir, DESPUÉS de arrancar AgentD: el agente no lo veía y abrir una ventana
# fallaba aunque el compositor estuviera vivo.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export HOME=/root

# Sobrescrituras locales (las escribe first-boot.sh / agentos-config).
load_config() {
    [ -f /etc/default/agentos ] && { set -a; . /etc/default/agentos; set +a; }
}

# Esperar a que haya RED DE VERDAD antes de arrancar AgentD.
# NetworkManager arranca en S45, pero conseguir IP y DNS tarda mas. Sin esto,
# AgentD consulta el backend remoto (Ollama Cloud) antes de que exista internet,
# no lo encuentra, termina con "No hay ningun backend LLM disponible" y muere.
# El socket nunca llega a crearse y la interfaz se queda esperandolo.
AGENTOS_NET_WAIT="${AGENTOS_NET_WAIT:-45}"
wait_for_network() {
    i=0
    while [ "$i" -lt "$AGENTOS_NET_WAIT" ]; do
        # 1.1.1.1 comprueba que hay ruta a internet; ollama.com, ademas, el DNS.
        if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && ping -c1 -W2 ollama.com >/dev/null 2>&1; then
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}

# Lanza AgentD una vez y espera su socket (max. 60 s). Devuelve 0 si esta listo.
launch_agentd() {
    # cd dentro del comando — BusyBox start-stop-daemon no soporta -d
    start-stop-daemon -S -q -b -m -p "$PIDFILE" \
        -x /bin/sh -- -c "cd $AGENTOS_HOME && exec $PYTHON -m core.ipc.socket_server >> $LOGFILE 2>&1"
    i=0
    while [ ! -S "$AGENTOS_SOCKET" ] && [ $i -lt 60 ]; do
        sleep 1; i=$((i + 1))
    done
    [ -S "$AGENTOS_SOCKET" ]
}

start() {
    load_config
    printf "Iniciando %s: " "$NAME"
    mkdir -p /run/agentos /data/agent /data/models
    chmod 0750 /run/agentos

    # El agente necesita red para su backend LLM remoto: esperarla primero.
    if wait_for_network; then
        printf "[red lista] "
    else
        printf "[aviso: sin red tras %ss] " "$AGENTOS_NET_WAIT"
    fi

    # Reintentar: si el backend aun no responde, el proceso termina y hay que
    # volver a lanzarlo. Tres intentos con 5 s entre ellos.
    intento=1
    while [ "$intento" -le 3 ]; do
        if launch_agentd; then
            echo "OK"
            start_gui
            return 0
        fi
        if [ "$intento" -lt 3 ]; then
            printf "[reintento %s] " "$intento"
            sleep 5
        fi
        intento=$((intento + 1))
    done

    # La interfaz ES la pantalla del SO: se arranca igualmente. Si AgentD no
    # está, ui/gui/server.py lo intenta en cada petición y la interfaz puede
    # decir en pantalla que no hay agente, en vez de dejar el compositor
    # vacío sin ninguna explicación.
    echo "AVISO (AgentD no responde tras 3 intentos; la interfaz se arranca igual: ver $LOGFILE)"
    start_gui
}

start_gui() {
    printf "Iniciando interfaz gráfica: "
    # La interfaz es la pantalla del SO: la ejecuta agentos-gui, un supervisor
    # que la relanza sola si el navegador o el servidor terminan. Se invoca vía
    # /bin/sh para no depender del bit de ejecución en el overlay.
    start-stop-daemon -S -q -b -m -p "$GUI_PIDFILE" \
        -x /bin/sh -- -c "exec /usr/bin/agentos-gui"
    echo "OK"
}

stop_gui() {
    [ -f "$GUI_PIDFILE" ] && start-stop-daemon -K -q -p "$GUI_PIDFILE" -s TERM
    rm -f "$GUI_PIDFILE"
}

stop() {
    stop_gui
    printf "Deteniendo %s: " "$NAME"
    start-stop-daemon -K -q -p "$PIDFILE" -s TERM
    i=0
    while [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && [ $i -lt 15 ]; do
        sleep 1; i=$((i + 1))
    done
    rm -f "$PIDFILE"
    echo "OK"
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME en ejecución (PID $(cat "$PIDFILE"))"
    else
        echo "$NAME detenido"; return 3
    fi
}

case "$1" in
    start)          start   ;;
    stop)           stop    ;;
    restart|reload) stop; start ;;
    status)         status  ;;
    *)  echo "Uso: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit $?
