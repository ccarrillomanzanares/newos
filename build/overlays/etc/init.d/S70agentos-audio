#!/bin/sh
# S70agentos-audio — deja el audio LISTO antes que la interfaz.
#
# Dos cosas, y las dos hacian falta:
#
# 1. CARGAR EL DRIVER. En una config de kernel generica los drivers son MODULOS
#    y la autocarga por modalias puede no disparar (el mismo fallo, aun sin
#    confirmar, que deja la GPU sin driver). Sin /dev/snd no hay ni micro ni
#    altavoz.
#
# 2. QUITAR EL MUTE. Muchos portatiles arrancan con el altavoz y el micro
#    SILENCIADOS en el mezclador. Ese era el sintoma "los controles se ven pero
#    no se oye" y "el volumen no hace nada": subir el control no sirve de nada si
#    la salida esta en [off]. Se quita el mute de salida Y de entrada.
#
# El trabajo fino lo hace ui/voice/audio_ctl.py: los NOMBRES de los controles
# cambian de una tarjeta a otra (Master/PCM/Speaker/Headphone...), asi que se
# enumeran y se actua sobre los que existan.

DRIVERS="snd_hda_intel snd_usb_audio snd_hda_codec_realtek snd_hda_codec_generic"
NAME=agentos-audio
AGENTOS_HOME=/opt/agentos

start() {
    printf "Iniciando %s: " "$NAME"
    for d in $DRIVERS; do modprobe "$d" 2>/dev/null; done
    i=0
    while [ ! -e /dev/snd/controlC0 ] && [ $i -lt 15 ]; do
        udevadm trigger --subsystem-match=sound 2>/dev/null
        udevadm settle --timeout=2 2>/dev/null
        sleep 1
        i=$((i+1))
    done

    if [ ! -e /dev/snd/controlC0 ]; then
        echo "[aviso: sin tarjeta de sonido] OK"
        return 0
    fi

    printf "[tarjeta ok] "
    # Desilenciar salida Y entrada, con el modulo (una sola fuente de verdad).
    if [ -d "$AGENTOS_HOME" ]; then
        PYTHONPATH="$AGENTOS_HOME" python3 -c "
import logging
from ui.voice import audio_ctl
logging.basicConfig(level=logging.WARNING)
hechos = audio_ctl.desilenciar_todo()
print('[mute quitado: %s] ' % (','.join(hechos) or 'ninguno'), end='')
" 2>/dev/null
    fi
    # Respaldo por si el modulo no estuviera: los controles mas comunes.
    for c in Master PCM Speaker Headphone Capture Mic; do
        amixer -c 0 sset "$c" unmute 2>/dev/null
    done
    amixer -c 0 sset "Master" 80% 2>/dev/null
    amixer -c 0 sset "PCM" 80% 2>/dev/null
    amixer -c 0 sset "Speaker" 80% 2>/dev/null
    amixer -c 0 sset "Capture" 80% cap 2>/dev/null
    amixer -c 0 sset "Mic" 80% cap 2>/dev/null
    echo "OK"
}

stop() { :; }

case "$1" in
    start|restart|reload) start ;;
    stop) stop ;;
    *) echo "Uso: $0 {start|stop}"; exit 1 ;;
esac
exit 0
